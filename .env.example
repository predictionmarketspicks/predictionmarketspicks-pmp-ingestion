# PMP Ingestion Engine — env vars
# All values are managed via `flyctl secrets set` in production.
# Copy to .env for local dev. Never commit .env.

# Kalshi (RSA-PSS — NOT HMAC)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Massive (was Polygon pre-rebrand)
MASSIVE_API_KEY=

# Polymarket (read-only is sufficient for v1)
POLYMARKET_API_KEY=

# Pyth Hermes
PYTH_HERMES_BASE=https://hermes.pyth.network

# Odds API
ODDS_API_KEY=

# PFF Developer API (Pro account key — generate at pff.com/account/api-keys)
# Powers grades-team + grades-player captures via scripts/capture-pff-api.js.
# power-ranks, free-agency, and dvoa-team have no Developer API coverage and
# still require the Claude-in-Chrome login path — see
# skills/nfl-ext-feeds-capture/SKILL.md §2b.
PFF_API_KEY=

# Supabase (service role — RLS bypass for engine writes)
SUPABASE_URL=https://svxqipncfupabpvxtlro.supabase.co
SUPABASE_SERVICE_KEY=

# Upstash Redis (dedup + hot cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Discord webhooks
DISCORD_WEBHOOK_CMDTY_EDGE=
DISCORD_WEBHOOK_PREMIUM_ALERTS=
DISCORD_WEBHOOK_ORACLE_PICKS=

# Vercel revalidation (preferred bearer; deploy hook fallback)
VERCEL_DEPLOY_HOOK_URL=
VERCEL_REVALIDATE_TOKEN=

# Observability
SENTRY_DSN=
ENGINE_ENV=dev

# Bridge-week tag: 'delayed_test' until Massive Advanced flips real-time, then 'intraday'
WRITER_TAG=delayed_test

# HTTP server
PORT=8080

# Discord bot token (used by src/delivery/discord.js postBotLog)
DISCORD_BOT_TOKEN=
